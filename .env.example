VLLM_MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct
VLLM_API_KEY=EMPTY
VLM_REQUEST_MAX_ATTEMPTS=3
VLM_REQUEST_RETRY_DELAY_SECONDS=1

# Optional local model overrides for ManipEval
