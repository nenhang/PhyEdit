# Optional experiment tracking
WANDB_API_KEY=

# RealManip-40K and ManipEval metadata
REALMANIP_METADATA_PATH=./data/RealManip-40K/metadata/train.jsonl
MANIPEVAL_METADATA_PATH=./data/RealManip-40K/metadata/test.json

# Depth Anything 3
DEPTH_MODEL_ID=depth-anything/da3nested-giant-large
DA_MODEL_PATH=depth-anything/da3nested-giant-large

# OpenAI-compatible VLM used by ManipEval
