---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"video"> {
  src: string;
}

const {
  src,
  class: className,
  controls = true,
  loop = true,
  playsinline = true,
  muted = true,
  autoplay = true,
  preload = "metadata",
  ...videoProps
} = Astro.props;
---

<video
  class:list={["h-auto w-full rounded-lg", className]}
  src={src}
  controls={controls}
  loop={loop}
  playsinline={playsinline}
  muted={muted}
  autoplay={autoplay}
  preload={preload}
  {...videoProps}></video>
